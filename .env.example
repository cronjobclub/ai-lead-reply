# Copy this file to .env and fill it in. Never share .env or commit it to GitHub.

# Required: your Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model writes the replies. claude-haiku-5-5 is the fastest and cheapest;
# switch to claude-sonnet-5-5 for more polished writing.
MODEL=claude-haiku-5-5

# Where the owner gets alerts and approval drafts.
OWNER_EMAIL=you@example.com

# outbox = save emails as files in ./outbox (start here, nothing is really sent)
# smtp   = really send email through Gmail (fill in the SMTP lines below)
# resend = really send email through Resend's API (use this on Railway/Render: they block SMTP)
SEND_MODE=outbox

# true = every reply goes to OWNER_EMAIL for approval instead of to the customer
REVIEW_MODE=false

# Gmail: SMTP_USER is your Gmail address, SMTP_PASSWORD is a 16-character
# app password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Resend (SEND_MODE=resend): API key from resend.com, and FROM_EMAIL on your verified domain
RESEND_API_KEY=

# Protect the /leads dashboard with ?token=... (required when PRODUCTION is on)
DASHBOARD_TOKEN=

# On a server: PRODUCTION=true locks the dashboard until DASHBOARD_TOKEN is set
# (Railway turns this on automatically). WEBHOOK_SECRET guards JSON posts from site builders.
PRODUCTION=false
WEBHOOK_SECRET=
MAX_LEADS_PER_IP_PER_HOUR=5
MAX_AI_CALLS_PER_DAY=200

# Cost column in the log, USD per million tokens. Check current prices:
# https://platform.claude.com/docs/en/about-claude/pricing
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
